{
  "name": "heat",
  "private": true,
  "description": "HEAT: a browser game about running an adventuring business, built as a technical showcase.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build && npm run test --workspaces --if-present",
    "typecheck": "npm run build && npm run typecheck --workspaces --if-present",
    "bundle:hub": "node scripts/bundle.mjs hub",
    "schema:print": "npm run schema:print --workspace @heat/hub",
    "local:api": "cd local && npx serverless offline"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "protobufjs@7.6.6": true,
    "@apollo/protobufjs@1.2.8": true,
    "ssh2@1.17.0": true
  }
}
