{
  "name": "heat",
  "private": true,
  "description": "HEAT: a browser game about running an adventuring business, built as a technical showcase.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build --workspace @heat/engine && npm run test --workspaces --if-present",
    "typecheck": "npm run build --workspace @heat/engine && npm run typecheck --workspaces --if-present",
    "lint": "npm run build --workspace @heat/engine && eslint .",
    "bundle": "npm run build --workspace @heat/engine && node scripts/bundle.mjs",
    "schema:print": "npm run schema:print --workspace @heat/hub",
    "codegen": "graphql-codegen --config codegen.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-codegen/fragment-matcher": "7.1.1",
    "@graphql-eslint/eslint-plugin": "4.4.2",
    "@types/node": "24.19.2",
    "angular-eslint": "22.6.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@graphql-eslint/eslint-plugin": {
      "@graphql-tools/utils": "12.1.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "@apollo/protobufjs@1.2.8": true,
    "ssh2@1.17.0": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
