{
  "name": "heat",
  "private": true,
  "description": "HEAT: a browser game about running an adventuring business, built as a technical showcase.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:hooks && npm run test:scripts && npm run build --workspace @heat/engine && npm run test --workspaces --if-present",
    "test:hooks": "node --test \".claude/hooks/*.test.mjs\"",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "typecheck": "npm run build --workspace @heat/engine && npm run typecheck --workspaces --if-present",
    "lint": "npm run build --workspace @heat/engine && eslint . --max-warnings 0",
    "lint:styles": "stylelint \"**/*.css\" --max-warnings 0",
    "bundle": "npm run build --workspace @heat/engine && node scripts/bundle.mjs",
    "schema:print": "npm run schema:print --workspace @heat/hub",
    "codegen": "graphql-codegen --config codegen.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/client-preset": "7.0.0",
    "@graphql-codegen/fragment-matcher": "8.0.0",
    "@graphql-eslint/eslint-plugin": "5.0.0",
    "@types/node": "26.6.11",
    "@vercel/nft": "1.11.12",
    "angular-eslint": "22.8.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-perfectionist": "5.14.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-testing-library": "7.16.3",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "sharp": "0.35.5",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@apollo/server": {
      "@graphql-tools/utils": "12.1.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "@apollo/protobufjs@1.2.8": true,
    "ssh2@1.17.0": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
