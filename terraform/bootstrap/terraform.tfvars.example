# Copy to terraform.tfvars (ignored by git) and put the real values in. Terraform
# loads that file on every run, whatever environment is being applied, which is
# why the workload ids are a map: the environment's own file (dev.tfvars) picks
# the entry. The ids are in docs/private/, never in a committed file; the
# address is the owner's. README.md shows the TF_VAR_* alternative.
platform_account_id = "123456789012"
workload_account_ids = {
  dev  = "210987654321"
  prod = "109876543210"
}
budget_alert_email = "owner@example.com"
