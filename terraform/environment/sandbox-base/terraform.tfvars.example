# For a plan on a laptop: copy to terraform.tfvars in this directory (ignored
# by git) and put the real values in, or set the three TF_VAR_* with the
# private script in docs/private/. The pipeline sets them from the repository
# secret HEAT_SANDBOX_ACCOUNT_ID and the sandbox-base environment's
# HEAT_GOOGLE_CLIENT_ID and HEAT_GOOGLE_CLIENT_SECRET (decision 0020). None
# of the three is ever committed.
workload_account_id  = "000000000000"
google_client_id     = "000000000000-example.apps.googleusercontent.com"
google_client_secret = "GOCSPX-example"
