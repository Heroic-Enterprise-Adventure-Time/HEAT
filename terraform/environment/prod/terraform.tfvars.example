# For a plan on a laptop: copy to terraform.tfvars in this directory (ignored
# by git). The account id is real, from the private script in docs/private/;
# the other three stay placeholders, because prod's values never cross a
# laptop (decision 0020). The pipeline sets all four from the repository
# variable HEAT_PROD_ACCOUNT_ID and the prod environment's HEAT_GOOGLE_CLIENT_ID,
# HEAT_GOOGLE_CLIENT_SECRET and HEAT_ALARM_EMAIL. None of the four is ever
# committed.
workload_account_id  = "000000000000"
google_client_id     = "000000000000-example.apps.googleusercontent.com"
google_client_secret = "GOCSPX-example"
alarm_email          = "alarms@example.com"
