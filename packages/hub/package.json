    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "schema:print": "node --import tsx scripts/print-schema.ts"
  },
  "dependencies": {
    "@apollo/server": "5.5.2",
    "@as-integrations/aws-lambda": "4.1.0",
    "@aws-lambda-powertools/logger": "2.36.0",
    "@aws-lambda-powertools/metrics": "2.36.0",
    "@aws-sdk/client-dynamodb": "3.1169.0",
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/lib-dynamodb": "3.1169.0",
    "@heat/engine": "0.0.0",
    "@middy/core": "7.9.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@pothos/core": "4.17.0",
    "@pothos/plugin-errors": "4.9.4",
    "@pothos/plugin-scope-auth": "4.3.0",
    "@pothos/plugin-tracing": "1.1.4",
    "@pothos/plugin-validation": "4.3.5",
    "@pothos/tracing-opentelemetry": "1.2.1",
    "electrodb": "3.9.3",
    "es-toolkit": "1.53.2",
