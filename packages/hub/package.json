{
  "name": "@heat/hub",
  "version": "0.0.0",
  "private": true,
  "description": "The GraphQL hub: Apollo Server on Lambda behind the HTTP API, Pothos schema, DynamoDB.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "schema:print": "node --import tsx scripts/print-schema.ts"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/aws-lambda": "4.1.0",
    "@aws-lambda-powertools/logger": "2.36.0",
    "@aws-lambda-powertools/tracer": "2.36.0",
    "@aws-sdk/client-dynamodb": "3.1157.0",
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/lib-dynamodb": "3.1157.0",
    "@heat/engine": "0.0.0",
    "@pothos/core": "4.16.0",
    "@pothos/plugin-scope-auth": "4.2.2",
    "es-toolkit": "1.53.1",
    "graphql": "16.14.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15"
  }
}
