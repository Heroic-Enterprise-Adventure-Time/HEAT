{
  "name": "@heat/client",
  "version": "0.0.0",
  "private": true,
  "description": "The Angular client: the browser game, served from each stack's bucket through CloudFront.",
  "type": "module",
  "scripts": {
    "art": "node scripts/copy-art.mjs",
    "prestart": "npm run art",
    "start": "ng serve",
    "prebuild": "npm run art",
    "build": "ng build",
    "pretest": "npm run art",
    "test": "ng test --watch=false",
    "typecheck": "tsc -p tsconfig.e2e.json --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@apollo/client": "4.3.6",
    "@heat/engine": "0.0.0",
    "apollo-angular": "14.2.0",
    "es-toolkit": "1.53.1",
    "graphql": "16.14.2",
    "oidc-client-ts": "3.5.0",
    "pixi.js": "8.22.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@playwright/test": "1.64.1",
    "@testing-library/angular": "19.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "30.1.3"
  }
}
