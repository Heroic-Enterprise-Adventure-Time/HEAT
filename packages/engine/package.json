{
  "name": "@heat/engine",
  "version": "0.0.0",
  "private": true,
  "description": "The deterministic game engine, shared by the Angular client, the verifier and the hub.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "es-toolkit": "1.53.2"
  }
}
