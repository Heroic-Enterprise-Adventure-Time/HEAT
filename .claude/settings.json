{
  "autoCompactWindow": 300000,
  "permissions": {
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin release:*)",
      "Bash(git push origin HEAD:release*)",
      "Bash(git push origin v*)",
      "Bash(git push origin refs/tags/*)",
      "Bash(git push --tags*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__ccd_turn__wrap_up",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/wrap-up-no-promises.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/allow-npm-in-worktree.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
