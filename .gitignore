# Private planning notes that must not be committed
docs/private/

# Terraform working files, state and variable files. State lives in the
# backend, never in git. Of the variable files, only the ones Terraform loads
# unasked are ignored, because those hold the account ids; a named
# per-environment file such as dev.tfvars holds nothing private and is
# committed (terraform/bootstrap/README.md).
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars
*.tfplan
*_override.tf
*_override.tf.json
crash.log

# IDE
.idea/

# Personal Claude Code files, never shared
CLAUDE.local.md
.claude/settings.local.json

# Node
node_modules/
dist/
*.tsbuildinfo
.serverless/
# serverless-offline runs the handler in a worker thread whose environment
# is only the function's, so it has no TEMP, and tsx's cache for the handler
# lands under a literal "undefined	emp" path beside the config.
local/undefined/
.env
.env.*
